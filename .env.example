# Create a client at https://www.warcraftlogs.com/api/clients/
# Redirect URL is unused (we use the client-credentials flow), any value works.
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# Optional. Only needed for the "coach narrative" button; findings work without it.
ANTHROPIC_API_KEY=

# Where raw WCL responses are cached. Delete this directory to force refetch.
WCL_CACHE_DIR=.cache
